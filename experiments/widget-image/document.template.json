{
  "type": "APL",
  "version": "2023.3",
  "theme": "dark",
  "mainTemplate": {
    "items": [
      {
        "type": "TouchWrapper",
        "width": "100vw",
        "height": "100vh",
        "onPress": [
          {
            "type": "SendEvent",
            "arguments": [
              "solar.widget.open.v1"
            ],
            "flags": {
              "interactionMode": "STANDARD"
            }
          }
        ],
        "item": {
          "type": "Container",
          "id": "imageWidget",
          "width": "100vw",
          "height": "100vh",
          "padding": 16,
          "bind": [
            {
              "name": "imageBase",
              "value": ""
            },
            {
              "name": "imageNonce",
              "value": 0
            },
            {
              "name": "lastRefresh",
              "value": 0
            },
            {
              "name": "loaded",
              "value": 0
            },
            {
              "name": "imageFailed",
              "value": false
            },
            {
              "name": "statusImageBase",
              "value": ""
            },
            {
              "name": "grantReady",
              "value": false
            },
            {
              "name": "grantRefreshAt",
              "value": 0
            },
            {
              "name": "lastGrantRequest",
              "value": 0
            },
            {
              "name": "accountMessage",
              "value": "Verbindung wird hergestellt …"
            }
          ],
          "handleTick": [
            {
              "minimumDelay": 1000,
              "when": "${elapsedTime - lastRefresh >= 60000}",
              "commands": [
                {
                  "type": "SetValue",
                  "componentId": "imageWidget",
                  "property": "imageNonce",
                  "value": "${elapsedTime}"
                },
                {
                  "type": "SetValue",
                  "componentId": "imageWidget",
                  "property": "lastRefresh",
                  "value": "${elapsedTime}"
                }
              ]
            },
            {
              "minimumDelay": 1000,
              "when": "${elapsedTime - lastGrantRequest >= 60000 && (!grantReady || elapsedTime >= grantRefreshAt)}",
              "commands": [
                {
                  "type": "SetValue",
                  "componentId": "imageWidget",
                  "property": "lastGrantRequest",
                  "value": "${elapsedTime}"
                },
                {
                  "type": "SendEvent",
                  "arguments": [
                    "solar.widget.images.v1"
                  ],
                  "flags": {
                    "interactionMode": "INLINE"
                  },
                  "sequencer": "widgetAccount"
                }
              ]
            }
          ],
          "items": [
            {
              "type": "Text",
              "text": "Solaranlage",
              "fontSize": 48,
              "fontWeight": "700",
              "color": "white",
              "maxLines": 1,
              "width": "100%"
            },
            {
              "type": "Text",
              "text": "Live · alle 60 Sekunden",
              "fontSize": 15,
              "color": "#FFD166",
              "spacing": 5,
              "maxLines": 1,
              "width": "100%"
            },
            {
              "type": "Container",
              "spacing": 18,
              "items": [
                {
                  "type": "Text",
                  "text": "PV + BKW",
                  "fontSize": 21,
                  "color": "white",
                  "maxLines": 1
                },
                {
                  "type": "Image",
                  "id": "valueImage0",
                  "source": "${imageBase ? imageBase + \"&page=live&row=0&col=0&layout=final&n=\" + imageNonce : ''}",
                  "width": "100%",
                  "height": 76,
                  "scale": "best-fit",
                  "align": "top-left",
                  "onLoad": [
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "loaded",
                      "value": "${loaded + 1}"
                    },
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "imageFailed",
                      "value": false
                    }
                  ],
                  "onFail": [
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "imageFailed",
                      "value": true
                    }
                  ],
                  "display": "${grantReady ? \"normal\" : \"none\"}"
                },
                {
                  "type": "Text",
                  "text": "—",
                  "fontSize": 48,
                  "color": "#AFC1D1",
                  "display": "${grantReady ? \"none\" : \"normal\"}"
                }
              ]
            },
            {
              "type": "Container",
              "spacing": 18,
              "items": [
                {
                  "type": "Text",
                  "text": "Hausverbrauch",
                  "fontSize": 21,
                  "color": "white",
                  "maxLines": 1
                },
                {
                  "type": "Image",
                  "id": "valueImage1",
                  "source": "${imageBase ? imageBase + \"&page=live&row=0&col=1&layout=final&n=\" + imageNonce : ''}",
                  "width": "100%",
                  "height": 76,
                  "scale": "best-fit",
                  "align": "top-left",
                  "onLoad": [
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "loaded",
                      "value": "${loaded + 1}"
                    },
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "imageFailed",
                      "value": false
                    }
                  ],
                  "onFail": [
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "imageFailed",
                      "value": true
                    }
                  ],
                  "display": "${grantReady ? \"normal\" : \"none\"}"
                },
                {
                  "type": "Text",
                  "text": "—",
                  "fontSize": 48,
                  "color": "#AFC1D1",
                  "display": "${grantReady ? \"none\" : \"normal\"}"
                }
              ]
            },
            {
              "type": "Container",
              "spacing": 18,
              "items": [
                {
                  "type": "Text",
                  "text": "Akku",
                  "fontSize": 21,
                  "color": "white",
                  "maxLines": 1
                },
                {
                  "type": "Image",
                  "id": "valueImage3",
                  "source": "${imageBase ? imageBase + \"&page=live&row=0&col=3&layout=final&n=\" + imageNonce : ''}",
                  "width": "100%",
                  "height": 76,
                  "scale": "best-fit",
                  "align": "top-left",
                  "onLoad": [
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "loaded",
                      "value": "${loaded + 1}"
                    },
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "imageFailed",
                      "value": false
                    }
                  ],
                  "onFail": [
                    {
                      "type": "SetValue",
                      "componentId": "imageWidget",
                      "property": "imageFailed",
                      "value": true
                    }
                  ],
                  "display": "${grantReady ? \"normal\" : \"none\"}"
                },
                {
                  "type": "Text",
                  "text": "—",
                  "fontSize": 48,
                  "color": "#AFC1D1",
                  "display": "${grantReady ? \"none\" : \"normal\"}"
                }
              ]
            },
            {
              "type": "Image",
              "id": "measurementStatus",
              "width": "100%",
              "height": 28,
              "spacing": 14,
              "scale": "best-fit",
              "align": "left",
              "source": "${statusImageBase ? statusImageBase + \"&n=\" + imageNonce : ''}",
              "display": "${grantReady ? \"normal\" : \"none\"}"
            },
            {
              "type": "Text",
              "text": "${imageFailed ? \"Bildabruf fehlgeschlagen\" : \"Antippen: Vollbild öffnen\"}",
              "fontSize": 13,
              "color": "#AFC1D1",
              "spacing": 4,
              "maxLines": 1
            },
            {
              "type": "Text",
              "text": "${accountMessage}",
              "fontSize": 13,
              "color": "#FFD166",
              "display": "${accountMessage ? \"normal\" : \"none\"}",
              "maxLines": 2
            }
          ]
        }
      }
    ]
  },
  "onMount": [
    {
      "type": "SendEvent",
      "arguments": [
        "solar.widget.images.v1"
      ],
      "flags": {
        "interactionMode": "INLINE"
      },
      "sequencer": "widgetAccount"
    }
  ]
}