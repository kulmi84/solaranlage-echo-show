                    {
                      "type": "ReloadWidget"
                    }
                  ],
                  "item": {
                    "type": "Text",
                    "text": "${loading ? \"Wird geladen …\" : \"Aktualisieren\"}",
                    "fontSize": 15,
                    "color": "#8BCBFF",
                    "maxLines": 1
                  }
                },
                {
                  "type": "Text",
                  "text": "${imageFailed ? \"Letzter Stand\" : \"\"}",
                  "fontSize": 12,
                  "color": "#FFD166",
                  "maxLines": 1
                }
              ]
            },
            {
              "type": "Text",
              "text": "${accountMessage}",
              "fontSize": 13,
              "color": "#FFD166",
              "display": "${accountMessage ? \"normal\" : \"none\"}",
              "maxLines": 2
            }
          ]
        }
      }
    ]
  },
  "onMount": [
    {
      "type": "SendEvent",
      "arguments": [
        "solar.widget.images.v1"
      ],
      "flags": {
        "interactionMode": "INLINE"
      },
      "sequencer": "widgetAccount"
    }
  ],
  "commands": {
    "ReloadWidget": {
      "commands": [
        {
          "type": "Sequential",
          "when": "${grantReady && !loading}",
          "commands": [
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "readyPv",
              "value": false
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "readyHome",
              "value": false
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "readyBattery",
              "value": false
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "readyStatus",
              "value": false
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "loading",
              "value": true
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "lastRefresh",
              "value": "${elapsedTime}"
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "lastImageNonce",
              "value": "${imageNonce}"
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "buffer0",
              "value": {
                "valueBase": "${imageBase}",
                "statusBase": "${statusImageBase}",
                "nonce": "${elapsedTime}"
              },
              "when": "${activeBuffer != 0}"
            },
            {
              "type": "SetValue",
              "componentId": "imageWidget",
              "property": "buffer1",
              "value": {
                "valueBase": "${imageBase}",
                "statusBase": "${statusImageBase}",
                "nonce": "${elapsedTime}"
              },
              "when": "${activeBuffer != 1}"
            }
          ]
        },
        {
          "type": "SendEvent",
          "when": "${!grantReady}",
          "arguments": [
            "solar.widget.images.v1"
          ],
          "flags": {
            "interactionMode": "INLINE"
          },
          "sequencer": "widgetAccount"
        }
      ]
    }
  }
}