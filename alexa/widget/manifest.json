            "keywords": [
              "Solaranlage",
              "Home Assistant",
              "PV",
              "Energie"
            ],
            "iconUri": "https://raw.githubusercontent.com/kulmi84/solaranlage-echo-show/main/assets/branding/solaranlage-icon-512.png",
            "previews": [
              "https://raw.githubusercontent.com/kulmi84/solaranlage-echo-show/main/docs/screenshots/echo-show-widget-2.0.1.png"
            ]
          }
        }
      ]
    }
  }
}
