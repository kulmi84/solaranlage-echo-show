{
  "name": "solaranlage-display",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DISPLAY_DB",
      "database_name": "solaranlage",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}